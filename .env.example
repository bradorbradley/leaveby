# Existing trip-planning server configuration. Never prefix private keys with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4.1

# PostHog is OFF until explicitly configured. Public write-only project token, never a personal API key.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Vercel exposes this automatically when system environment variables are enabled.
# Outside Vercel, set production only on a reviewed production build; never on preview/local builds.
NEXT_PUBLIC_VERCEL_ENV=
# Comma-separated operator-approved public campaign codes. Unlisted values become "other".
NEXT_PUBLIC_ANALYTICS_CAMPAIGNS=launch
